# Copy to `.env.local` (git-ignored) to override. Every value has a working default.

# The web UI's server talks to the Training, Attendance & Assessment Service through RabbitMQ:
# each request is a message on the service's queue, answered on a reply queue. Read on the
# server only: the browser never talks to RabbitMQ or to the service.
# - RabbitMQ on your machine (docker compose up -d rabbitmq): the URL below
# - inside docker compose the `web` service is given amqp://…@rabbitmq:5672 automatically
RABBITMQ_URL=amqp://training:training_dev_password@localhost:5672

# The queue the service listens on (the service's RABBITMQ_QUEUE, this is its default).
# RABBITMQ_QUEUE=training_attendance_assessment

# How long to wait for the service to answer, in milliseconds.
# RABBITMQ_TIMEOUT_MS=10000
