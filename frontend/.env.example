# Copy to `.env.local` (git-ignored) to override. Every value has a working default.

# Where the Training, Attendance & Assessment Service (NestJS API) listens.
# Read on the server only: the browser never calls the API directly.
# - running the API on your machine / docker compose "db"+"api" ports: http://localhost:4000
# - inside docker compose the `web` service is given http://api:4000 automatically
BACKEND_URL=http://localhost:4000
