# Used by `docker compose` (run from the repository root). Copy to `.env` (git-ignored);
# every value has a working default, so the file is optional.

# --- PostgreSQL ---------------------------------------------------------------
POSTGRES_USER=attendance
# Keep this URL-safe (letters/digits/-/_): it is embedded in the API's DATABASE_URL.
POSTGRES_PASSWORD=attendance_dev_password
POSTGRES_DB=attendance_service
# Host port. 5432-5434 are commonly taken by other local Postgres containers.
POSTGRES_PORT=5435

# --- RabbitMQ (the gateway between the web UI and the API) -------------------
RABBITMQ_USER=training
# Keep this URL-safe (letters/digits/-/_): it is embedded in the AMQP connection string.
RABBITMQ_PASSWORD=training_dev_password
# Host ports: AMQP, and the management UI (http://localhost:15672).
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# --- Published ports on your machine -----------------------------------------
# Web UI (Next.js)
WEB_PORT=3000
# API (NestJS) + Swagger at /docs
PORT=4000

# Browser origin(s) the API accepts for direct HTTP calls (the web UI's server asks the
# API through RabbitMQ, so this only matters for other clients).
CORS_ORIGIN=http://localhost:3000
