# Copy to `.env` (git-ignored). Only needed to run the API / Prisma CLI on your machine;
# the Docker stack (../docker-compose.yml) configures itself from the repository-root .env.

PORT=4000
# Allowed browser origin(s) for direct calls to the API (comma-separated).
CORS_ORIGIN=http://localhost:3000

# PostgreSQL started by `docker compose up -d db` from the repository root
# (host port 5435; user/password/database are the defaults in ../.env.example).
DATABASE_URL=postgresql://attendance:attendance_dev_password@localhost:5435/attendance_service?schema=public
