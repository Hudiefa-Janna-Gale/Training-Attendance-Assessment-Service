# Copy to `.env` (git-ignored) and adjust. Used by the app, Prisma CLI and docker compose.

# --- API -------------------------------------------------------------------
PORT=4000
# Allowed browser origin for the Next.js frontend (comma-separated for several).
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL (docker compose `db` service) -------------------------------
POSTGRES_USER=attendance
# Keep this URL-safe (letters/digits/-/_) because it is embedded in DATABASE_URL.
POSTGRES_PASSWORD=attendance_dev_password
POSTGRES_DB=attendance_service
# Host port. 5432-5434 are commonly taken by other local Postgres containers.
POSTGRES_PORT=5435

# --- Prisma -----------------------------------------------------------------
# For running the API / Prisma CLI on your machine against the compose database.
# (Inside compose the api container gets its own DATABASE_URL pointing at `db:5432`.)
DATABASE_URL=postgresql://attendance:attendance_dev_password@localhost:5435/attendance_service?schema=public
